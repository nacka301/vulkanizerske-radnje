# Supabase (lokalni `supabase start` ispisuje ove vrijednosti; za produkciju
# koristi vrijednosti iz Supabase dashboarda projekta)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (captcha na javnom flowu rezervacije)
# Za lokalni razvoj koristi Cloudflareove test kljuceve:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SMS
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_SENDER_ID=Vulkanizer

# Aplikacija
APP_BASE_URL=http://localhost:3000

# Dijeljena tajna izmedju pg_cron/pg_net i sms-worker Edge Functiona
WORKER_SECRET=
