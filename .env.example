# Supabase (lokalni `supabase start` ispisuje ove vrijednosti; za produkciju
# koristi vrijednosti iz Supabase dashboarda projekta)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (captcha na javnom flowu rezervacije)
# Za lokalni razvoj koristi Cloudflareove test kljuceve:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SMS
# Napomena: sms-worker Edge Function (supabase/functions/sms-worker) cita
# SMS_PROVIDER/SMS_SENDER_ID/INFOBIP_*/WORKER_SECRET iz `app_settings`
# tablice, ne iz ovih env varijabli — Supabase MCP alat koji je koristen za
# deploy nema nacin postavljanja Edge Function secreta. Za pravu CLI
# instalaciju (`supabase secrets set`) ove varijable ostaju referenca; vidi
# DECISIONS.md ("Faza 3"). Da promijenis provider/sender/kljuceve, azuriraj
# `app_settings` (npr. preko Supabase Studio ili `update app_settings set
# value = ... where key = 'sms_provider'`).
SMS_PROVIDER=console
# console | infobip
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
SMS_SENDER_ID=Vulkanizer

# Aplikacija
APP_BASE_URL=http://localhost:3000

# Dijeljena tajna izmedju pg_cron/pg_net i sms-worker Edge Functiona.
# Trenutno pohranjena i u app_settings.worker_secret (vidi gore) — ovdje
# ostaje kao referenca za buducu CLI/secrets-based instalaciju.
WORKER_SECRET=
